# =============================================================
# TAHRA AI - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================

# --- 1. LLM Provider (Groq / OpenClaw / Hermes-3 / OpenAI) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- 2. Database Configuration (PostgreSQL in Docker) ---
POSTGRES_DB=tahra_db
POSTGRES_USER=tahra_admin
POSTGRES_PASSWORD=tahra_secure_password_2026

# --- 3. App Settings ---
ENVIRONMENT=production
PORT=80
BACKEND_PORT=8000
