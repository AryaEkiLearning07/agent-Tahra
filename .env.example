# =============================================================
# TAHRA AI - PRODUCTION ENVIRONMENT CONFIGURATION (MARIADB 11.4)
# =============================================================

# --- 1. LLM Provider (Groq / OpenClaw / Hermes-3 / OpenAI) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- 2. Database Configuration (MariaDB 11.4 in Docker / XAMPP) ---
MARIADB_ROOT_PASSWORD=tahra_root_secure_2026
MARIADB_DATABASE=tahra_db
MARIADB_USER=tahra_admin
MARIADB_PASSWORD=tahra_secret_2026
DB_PORT=3307

# --- 3. App Settings (Conflict-Free Host Ports) ---
ENVIRONMENT=production
FRONTEND_PORT=8080
BACKEND_PORT=8001
