{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tahra-ai/schemas/agent1_output.schema.json",
  "title": "Agent1DeepMarketResearchOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "generated_at", "niche", "lokasi",
    "market_sizing", "kompetitor", "pain_points", "usp",
    "audiens", "benchmark_iklan", "creative_inspiration"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "generated_at": { "type": "string", "format": "date-time" },
    "niche": { "type": "string", "minLength": 1, "maxLength": 80 },
    "lokasi": { "type": "string", "minLength": 1, "maxLength": 120 },

    "market_sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimasi_pesaing_radius_5km", "harga_pasar_rp_per_kg", "keyword_volume"],
      "properties": {
        "estimasi_pesaing_radius_5km": { "type": "integer", "minimum": 0 },
        "harga_pasar_rp_per_kg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "keyword_volume": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyword", "volume_bulanan", "arah_tren", "delta_persen_3bulan", "sumber"],
            "properties": {
              "keyword": { "type": "string", "minLength": 1 },
              "volume_bulanan": { "type": "integer", "minimum": 0 },
              "arah_tren": { "type": "string", "enum": ["naik", "turun", "stabil"] },
              "delta_persen_3bulan": { "type": "number" },
              "sumber": { "type": "string", "enum": ["google_trends", "google_keyword_planner"] }
            }
          }
        }
      }
    },

    "kompetitor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nama", "tipe", "rating", "jumlah_review", "harga_rp_per_kg",
          "aktif_iklan_di", "celah_kelemahan", "confidence_score", "sumber"
        ],
        "properties": {
          "nama": { "type": "string", "minLength": 1 },
          "tipe": { "type": "string", "enum": ["direct", "indirect"] },
          "rating": { "type": "number", "minimum": 0, "maximum": 5 },
          "jumlah_review": { "type": "integer", "minimum": 0 },
          "harga_rp_per_kg": { "type": "number", "minimum": 0 },
          "aktif_iklan_di": {
            "type": "array",
            "items": { "type": "string", "enum": ["meta", "tiktok", "google"] }
          },
          "celah_kelemahan": { "type": "string", "maxLength": 200 },
          "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "sumber": {
            "type": "string",
            "enum": ["google_maps", "meta_ad_library", "tiktok_creative_center", "website_kompetitor"]
          }
        }
      }
    },

    "pain_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["angle", "insight", "frekuensi_skor", "sumber"],
        "properties": {
          "angle": { "type": "string", "enum": ["financial", "functional", "emotional"] },
          "insight": { "type": "string", "maxLength": 200 },
          "frekuensi_skor": { "type": "number", "minimum": 0, "maximum": 1 },
          "sumber": {
            "type": "string",
            "enum": ["google_maps_reviews", "instagram_komentar", "tiktok_komentar", "forum_lokal"]
          }
        }
      }
    },

    "usp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["klaim", "metode_verifikasi", "confidence_score"],
      "properties": {
        "klaim": { "type": "string", "maxLength": 150 },
        "metode_verifikasi": { "type": "string", "maxLength": 200 },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "audiens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_dominan", "funnel_stage_dominan"],
      "properties": {
        "platform_dominan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "persen_estimasi", "sumber"],
            "properties": {
              "platform": { "type": "string", "enum": ["instagram", "tiktok", "facebook", "google_search"] },
              "persen_estimasi": { "type": "number", "minimum": 0, "maximum": 100 },
              "sumber": { "type": "string", "minLength": 1 }
            }
          }
        },
        "funnel_stage_dominan": { "type": "string", "enum": ["awareness", "consideration", "decision"] }
      }
    },

    "benchmark_iklan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta_ads_cpm_rp", "google_ads_cpc_rp"],
      "properties": {
        "meta_ads_cpm_rp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "google_ads_cpc_rp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        }
      }
    },

    "creative_inspiration": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "format", "pola_hook", "sumber"],
        "properties": {
          "platform": { "type": "string", "enum": ["meta", "tiktok"] },
          "format": {
            "type": "string",
            "enum": ["video_ugc", "video_studio", "gambar_before_after", "gambar_testimoni"]
          },
          "pola_hook": { "type": "string", "maxLength": 100 },
          "sumber": { "type": "string", "enum": ["meta_ad_library", "tiktok_creative_center"] }
        }
      }
    }
  }
}
