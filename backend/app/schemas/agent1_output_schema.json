{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent1DeepMarketResearchOutput",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "niche",
    "lokasi",
    "market_sizing",
    "kompetitor",
    "pain_points",
    "usp",
    "audiens",
    "benchmark_iklan",
    "creative_inspiration"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "niche": { "type": "string", "maxLength": 80 },
    "lokasi": { "type": "string", "maxLength": 120 },

    "market_sizing": {
      "type": "object",
      "required": ["estimasi_pesaing_radius_5km", "harga_pasar_rp_per_kg", "keyword_volume"],
      "properties": {
        "estimasi_pesaing_radius_5km": { "type": "integer", "minimum": 0 },
        "harga_pasar_rp_per_kg": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "keyword_volume": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["keyword", "volume_bulanan", "arah_tren", "delta_persen_3bulan", "sumber"],
            "properties": {
              "keyword": { "type": "string" },
              "volume_bulanan": { "type": "integer", "minimum": 0 },
              "arah_tren": { "type": "string", "enum": ["naik", "stabil", "turun"] },
              "delta_persen_3bulan": { "type": "number" },
              "sumber": { "type": "string", "enum": ["google_trends", "manual_audit"] }
            }
          }
        }
      }
    },

    "kompetitor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nama", "tipe", "rating", "jumlah_review", "harga_rp_per_kg", "aktif_iklan_di", "celah_kelemahan", "confidence_score", "sumber"],
        "properties": {
          "nama": { "type": "string" },
          "tipe": { "type": "string", "enum": ["direct", "indirect"] },
          "rating": { "type": "number", "minimum": 0, "maximum": 5 },
          "jumlah_review": { "type": "integer", "minimum": 0 },
          "harga_rp_per_kg": { "type": "number", "minimum": 0 },
          "aktif_iklan_di": {
            "type": "array",
            "items": { "type": "string" }
          },
          "celah_kelemahan": { "type": "string" },
          "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "sumber": { "type": "string" }
        }
      }
    },

    "pain_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["angle", "insight", "frekuensi_skor", "sumber"],
        "properties": {
          "angle": { "type": "string" },
          "insight": { "type": "string" },
          "frekuensi_skor": { "type": "number", "minimum": 0, "maximum": 1 },
          "sumber": { "type": "string" }
        }
      }
    },

    "usp": {
      "type": "object",
      "required": ["klaim", "metode_verifikasi", "confidence_score"],
      "properties": {
        "klaim": { "type": "string" },
        "metode_verifikasi": { "type": "string" },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "audiens": {
      "type": "object",
      "required": ["platform_dominan", "funnel_stage_dominan"],
      "properties": {
        "platform_dominan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["platform", "persen_estimasi", "sumber"],
            "properties": {
              "platform": { "type": "string" },
              "persen_estimasi": { "type": "number", "minimum": 0, "maximum": 100 },
              "sumber": { "type": "string" }
            }
          }
        },
        "funnel_stage_dominan": { "type": "string" }
      }
    },

    "benchmark_iklan": {
      "type": "object",
      "required": ["meta_ads_cpm_rp", "google_ads_cpc_rp"],
      "properties": {
        "meta_ads_cpm_rp": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "google_ads_cpc_rp": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        }
      }
    },

    "creative_inspiration": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "format", "pola_hook", "sumber"],
        "properties": {
          "platform": { "type": "string" },
          "format": { "type": "string" },
          "pola_hook": { "type": "string" },
          "sumber": { "type": "string" }
        }
      }
    }
  }
}
